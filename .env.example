# Copy to .env and fill in real values. .env is gitignored; never commit it.
# ---------------------------------------------------------------------------

# --- Auth / login (control-plane) ---
# The single fixed user allowed to log in.
LOGIN_EMAIL=tester@wns.com
LOGIN_PASSWORD=halotest
# Secret used to sign JWTs. Change to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# --- LLM (persona services) via the TrueFoundry AI Gateway ---
# OpenAI-compatible endpoint. LLM_API_KEY is a TrueFoundry Personal Access Token.
# LLM_BASE_URL is your gateway base URL — copy the exact value from the gateway's
# code snippet in the TrueFoundry console. LLM_MODEL uses the gateway's
# "provider_account/model_name" form (e.g. openai-main/gpt-4o-mini).
# Leave LLM_API_KEY empty to run with graceful fallback lines (no key needed).
LLM_API_KEY=
LLM_BASE_URL=https://<your-org>.truefoundry.cloud/api/llm
LLM_MODEL=openai-main/gpt-5.6-luna

# --- Service-to-service URLs (control-plane -> persona services) ---
# Local docker-compose values (service-name DNS). Override in the cloud.
COWBOY_SERVICE_URL=http://cowboy-service:8001
OSHO_SERVICE_URL=http://osho-service:8002

# --- Datastores (control-plane) ---
DATABASE_URL=postgresql://app:app@postgres:5432/appdb
REDIS_URL=redis://redis:6379/0

# --- Postgres container bootstrap (used by the postgres service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appdb

# --- CORS: origin allowed to call the control-plane API ---
UI_ORIGIN=*

# --- UI (browser -> control-plane) ---
# Public URL of the control-plane, injected into the UI at container start.
CONTROL_PLANE_URL=http://localhost:8000
